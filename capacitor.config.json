{
  "appId": "com.pollar.stellarp2p",
  "appName": "Pollar Pay",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#07090e",
    "allowMixedContent": true
  },
  "plugins": {
    "GoogleAuth": {
      "scopes": [
        "profile",
        "email"
      ],
      "serverClientId": "REPLACE_WITH_YOUR_WEB_CLIENT_ID_FROM_GOOGLE_CLOUD_CONSOLE",
      "forceCodeForRefreshToken": true
    },
    "Preferences": {
      "group": "com.pollar.stellarp2p.prefs"
    },
    "NativeBiometric": {
      "useFallbackAuthentication": true
    },
    "BarcodeScanner": {
      "android": {
        "useFallback": true
      }
    }
  }
}